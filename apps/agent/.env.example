# ─────────────────────────────────────────────────────────────
# NeoWealth Agent — environment
# Copy to .env:  cp apps/agent/.env.example apps/agent/.env
# Values shown are code defaults; only fill in what you need to change.
# ─────────────────────────────────────────────────────────────

# --- LLM / OpenAI ---
OPENAI_API_KEY=                                  # required (secret)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_ANSWER=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# --- Server / URLs ---
PORT=8000
# FRONTEND_URL: where the agent root "/" redirects to (not used for login/CORS).
FRONTEND_URL=http://localhost:3000
# Remote/EC2 example:
# FRONTEND_URL=https://neowealth-agent.neosapientai.com
BACKEND_URL=http://localhost:8080
AGENT_URL=http://localhost:8000

# --- MCP (market data) ---
MCP_URL=https://neowealth-dp.neosapientai.com/v1/mcp
MCP_API_KEY=                                     # secret (code reads MCP_API_KEY)
REDIS_URL=

# --- Memory ---
MEMORY_ENABLED=true
MEMORY_ADVISOR_ONLY=true
QDRANT_URL=http://localhost:6333

# --- Skills ---
SKILLS_ENABLED=true
SKILLS_BACKEND_SYNC=true
SKILLS_REFRESH_TTL=300
AGENT_SKILLS_TOKEN=neowealth-internal-skills     # must match backend

# --- Web search ---
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=ceramic                       # ceramic | serper | tavily
WEB_SEARCH_COUNTRY=in
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
CERAMIC_API_KEY=                                  # secret
SERPER_API_KEY=                                  # secret
TAVILY_API_KEY=                                  # secret

# --- Pipeline feature flags ---
PLANNER_ENABLED=true
DECOMPOSITION_ENABLED=true
MAX_SUBQUESTIONS=4
VERIFY_ENABLED=true
ANSWER_VERIFY_ENABLED=true
SMART_REFINE_ENABLED=true
FUND_RECOVERY_ENABLED=true
QUICKFACTS_STANDALONE_ONLY=true
RECOMMENDATION_BENCHMARK_MARGIN=0.0

# --- Guardrails ---
GUARDRAILS_ENABLED=false
GUARDRAIL_CONFIG_PATH=./configs
NEO_LLM_GUARD_MODELS_DIR=

# --- Observability ---
NS_PROBE_ENDPOINT=http://localhost:4318/v1/traces
NS_PROBE_ENVIRONMENT=development
